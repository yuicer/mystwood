page {
  min-height: 100vh;
  background: linear-gradient(180deg, #f9fcf8 0%, #eef6ed 42%, #dcebdd 100%);
  color: #203329;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
}

.page-wrap {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 48rpx;
}

.card {
  background: #ffffff;
  border: 1px solid #dce8da;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(31, 83, 59, 0.06);
}

.section-title {
  color: #203329;
  font-size: 38rpx;
  font-weight: 600;
  line-height: 1.35;
}

.page-title {
  color: #203329;
  font-size: 44rpx;
  font-weight: 600;
  line-height: 1.3;
}

.page-subtitle {
  margin-top: 12rpx;
  color: #66766a;
  font-size: 27rpx;
  line-height: 1.55;
}

.field-label {
  color: #66766a;
  font-size: 23rpx;
  line-height: 1.4;
}

.field,
.picker-field {
  box-sizing: border-box;
  margin-top: 12rpx;
  border: 1px solid #dce8da;
  padding: 18rpx 22rpx;
  border-radius: 16rpx;
  background: #fff;
  color: #203329;
}

.btn-stack {
  margin-top: 24rpx;
}

.list-item {
  padding: 24rpx 0;
}

button {
  min-height: 88rpx;
  border-radius: 16rpx;
  font-weight: 500;
  border: 1px solid #dce8da;
  background: #ffffff;
  color: #203329;
  letter-spacing: 0;
}

button::after {
  border: 0;
}

.btn-primary {
  background: #296448;
  color: #ffffff;
  border: 1px solid #296448;
  box-shadow: none;
}

.btn-danger {
  background: #ad6657;
  color: #ffffff;
  border: 1px solid #ad6657;
  box-shadow: none;
}

.hint {
  color: #66766a;
  font-size: 24rpx;
  line-height: 1.5;
}

.location-link {
  color: #296448;
}
