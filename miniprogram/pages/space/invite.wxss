.invite-page {
  display: flex;
  flex-direction: column;
}

.invite-summary {
  display: flex;
  align-items: center;
  gap: 28rpx;
  margin-top: 108rpx;
  padding: 0 0 40rpx;
  border-bottom: 1px solid #dce8da;
}

.treehouse-mark {
  flex: 0 0 72rpx;
  width: 72rpx;
  height: 72rpx;
}

.invite-summary-copy {
  flex: 1;
  min-width: 0;
}

.invite-space-name {
  color: #203329;
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1.35;
  word-break: break-all;
}

.invite-space-desc {
  margin-top: 8rpx;
}

.status-tag {
  display: inline-flex;
  align-items: center;
  min-height: 44rpx;
  margin-top: 20rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 44rpx;
}

.waiting-tag {
  background: #faf0dd;
  color: #88672e;
}

.active-tag {
  background: #e4eedf;
  color: #296448;
}

.received-summary {
  position: relative;
  align-items: flex-start;
}

.received-mark {
  position: absolute;
  right: 4rpx;
  top: 0;
}

.received-summary .invite-summary-copy {
  padding-right: 96rpx;
}

.invite-message {
  margin-top: 34rpx;
  color: #66766a;
  font-size: 27rpx;
  line-height: 1.65;
}

.invite-main-button {
  width: 100%;
  height: 96rpx;
  margin-top: auto;
  margin-bottom: 40rpx;
  line-height: 96rpx;
  font-size: 30rpx;
}

.invite-empty {
  display: flex;
  flex: 1;
  flex-direction: column;
}
