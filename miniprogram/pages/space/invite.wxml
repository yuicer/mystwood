<view class="page-wrap">
  <view wx:if="{{space}}" class="card">
    <view class="section-title">{{space.name}}</view>
    <block wx:if="{{space.status === 'pending'}}">
      <view class="hint" style="margin:12rpx 0 20rpx;">这封邀请已经寄出，等 TA 查收。</view>
      <button class="btn-primary" open-type="share">提醒 TA 查收</button>
    </block>
    <view wx:else class="hint" style="margin-top:12rpx;">TA 已经加入这片森林。</view>
  </view>

  <view wx:elif="{{invite}}" class="card">
    <view class="section-title">{{invite.name}}</view>
    <view class="hint" style="margin:12rpx 0 20rpx">对方邀请你加入这个空间。</view>
    <button class="btn-primary" bindtap="acceptInvite">接受邀请</button>
  </view>

  <view wx:else class="card">
    <view class="hint">你还没有空间，先创建一个吧。</view>
    <button class="btn-primary btn-stack" bindtap="goCreate">去创建</button>
  </view>
</view>
