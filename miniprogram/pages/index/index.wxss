.index-page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}

.loading-card,
.load-error-card,
.empty-card {
  min-height: 360rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  margin-bottom: 24rpx;
  border: 6rpx solid rgba(47, 47, 47, 0.12);
  border-top-color: #2f2f2f;
  border-radius: 999rpx;
  animation: mystwood-spin 0.9s linear infinite;
}

@keyframes mystwood-spin {
  to {
    transform: rotate(360deg);
  }
}

.loading-title,
.empty-title {
  font-size: 36rpx;
  font-weight: 600;
}

.empty-copy {
  margin: 12rpx 0 20rpx;
}

.error-hint {
  margin: 12rpx 0 20rpx;
}

.sync-strip {
  display: inline-flex;
  align-items: center;
  margin: 0 0 16rpx;
  padding: 8rpx 16rpx;
  border: 1px solid rgba(47, 47, 47, 0.08);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.76);
  color: #5f5d59;
  font-size: 22rpx;
}

.sync-dot {
  width: 12rpx;
  height: 12rpx;
  margin-right: 10rpx;
  border-radius: 999rpx;
  background: #2b6777;
  animation: mystwood-pulse 1.2s ease-in-out infinite;
}

@keyframes mystwood-pulse {
  0%,
  100% {
    opacity: 0.36;
    transform: scale(0.86);
  }

  50% {
    opacity: 1;
    transform: scale(1);
  }
}

.space-card {
  padding: 26rpx;
  background: rgba(255, 255, 255, 0.92);
  border-color: rgba(55, 53, 47, 0.08);
}

.theme-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.theme-title {
  flex: 1;
  min-width: 0;
  max-height: 96rpx;
  color: #252525;
  font-size: 38rpx;
  font-weight: 600;
  line-height: 1.25;
  display: -webkit-box;
  overflow: hidden;
  word-break: break-all;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.settings-icon {
  width: 48rpx;
  height: 48rpx;
  margin: 0 0 0 16rpx;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: 999rpx;
  background: transparent;
  line-height: 1;
}

.settings-icon-image {
  width: 32rpx;
  height: 32rpx;
  display: block;
}

.theme-meta {
  display: flex;
  align-items: stretch;
  justify-content: space-between;
  margin-top: 24rpx;
}

.space-summary {
  flex: 1;
  min-width: 0;
  padding: 18rpx 20rpx;
  border: 1px solid #eef0ec;
  border-radius: 16rpx;
  background: #fbfbfa;
}

.happy-line {
  color: #4d4b47;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.35;
  word-break: break-all;
}

.memory-link {
  width: 184rpx;
  margin: 0 0 0 16rpx;
  padding: 18rpx 16rpx;
  border: 1px solid #e3e8e7;
  border-radius: 16rpx;
  background: #f6faf9;
  color: #315f65;
  text-align: left;
  line-height: 1.35;
}

.memory-title {
  font-size: 25rpx;
  font-weight: 600;
}

.memory-count {
  margin-top: 10rpx;
  color: #6f8587;
  font-size: 22rpx;
}

.invite-card {
  text-align: center;
}

.invite-button {
  margin-top: 12rpx;
}

.entry-section {
  margin-bottom: 20rpx;
}

.entry-main {
  margin: 0;
  border-radius: 16rpx;
  text-align: left;
  line-height: 1.3;
}

.entry-main::after,
.settings-icon::after,
.memory-link::after,
.finish-button::after {
  border: 0;
}

.entry-main {
  width: 100%;
  min-height: 176rpx;
  display: flex;
  align-items: center;
  padding: 28rpx;
  border: 0;
  background: #2f2f2f;
  color: #ffffff;
}

.entry-plus {
  width: 64rpx;
  height: 64rpx;
  margin-right: 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  color: #ffffff;
  font-size: 46rpx;
  line-height: 58rpx;
  text-align: center;
}

.entry-copy {
  flex: 1;
  min-width: 0;
}

.entry-title {
  font-size: 32rpx;
  font-weight: 600;
}

.entry-desc {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 23rpx;
}

.task-title {
  margin-bottom: 12rpx;
}

.task-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.task-info {
  flex: 1;
  min-width: 0;
  padding-right: 16rpx;
}

.task-name {
  font-size: 28rpx;
  line-height: 1.4;
  word-break: break-all;
}

.finish-button {
  margin: 0;
  padding: 0 20rpx;
  background: #eef6f3;
  border-color: #cfe3da;
  color: #1f6b54;
  line-height: 54rpx;
}
