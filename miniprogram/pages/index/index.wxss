.index-page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}

.loading-card,
.load-error-card,
.empty-card {
  min-height: 360rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.loading-spinner {
  width: 56rpx;
  height: 56rpx;
  border: 6rpx solid rgba(47, 47, 47, 0.12);
  border-top-color: #2f2f2f;
  border-radius: 999rpx;
  animation: mystwood-spin 0.9s linear infinite;
}

@keyframes mystwood-spin {
  to {
    transform: rotate(360deg);
  }
}

.empty-title {
  font-size: 36rpx;
  font-weight: 600;
}

.empty-copy {
  margin: 12rpx 0 20rpx;
}

.error-hint {
  margin: 12rpx 0 20rpx;
}

.space-card {
  padding: 26rpx;
  background: rgba(255, 255, 255, 0.92);
  border-color: rgba(55, 53, 47, 0.08);
}

.theme-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.theme-title {
  flex: 1;
  min-width: 0;
  max-height: 96rpx;
  color: #252525;
  font-size: 38rpx;
  font-weight: 600;
  line-height: 1.25;
  display: -webkit-box;
  overflow: hidden;
  word-break: break-all;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.settings-icon {
  width: 48rpx;
  height: 48rpx;
  margin: 0 0 0 16rpx;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: 999rpx;
  background: transparent;
  line-height: 1;
}

.settings-icon-image {
  width: 32rpx;
  height: 32rpx;
  display: block;
}

.theme-meta {
  display: flex;
  align-items: stretch;
  justify-content: space-between;
  margin-top: 24rpx;
}

.space-summary {
  flex: 1;
  min-width: 0;
  padding: 18rpx 20rpx;
  border: 1px solid #eef0ec;
  border-radius: 16rpx;
  background: #fbfbfa;
}

.happy-line {
  color: #4d4b47;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.35;
  word-break: break-all;
}

.memory-link {
  width: 184rpx;
  margin: 0 0 0 16rpx;
  padding: 18rpx 16rpx;
  border: 1px solid #e3e8e7;
  border-radius: 16rpx;
  background: #f6faf9;
  color: #315f65;
  text-align: left;
  line-height: 1.35;
}

.memory-title {
  font-size: 25rpx;
  font-weight: 600;
}

.memory-count {
  margin-top: 10rpx;
  color: #6f8587;
  font-size: 22rpx;
}

.invite-card {
  text-align: center;
}

.invite-button {
  margin-top: 12rpx;
}

.entry-section {
  margin-bottom: 20rpx;
}

.entry-main {
  margin: 0;
  border-radius: 16rpx;
  text-align: left;
  line-height: 1.3;
}

.entry-main::after,
.settings-icon::after,
.memory-link::after {
  border: 0;
}

.entry-main {
  width: 100%;
  min-height: 176rpx;
  display: flex;
  align-items: center;
  padding: 28rpx;
  border: 0;
  background: #2f2f2f;
  color: #ffffff;
}

.entry-plus {
  width: 64rpx;
  height: 64rpx;
  margin-right: 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  color: #ffffff;
  font-size: 46rpx;
  line-height: 58rpx;
  text-align: center;
}

.entry-copy {
  flex: 1;
  min-width: 0;
}

.entry-title {
  font-size: 32rpx;
  font-weight: 600;
}

.entry-desc {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 23rpx;
}

.task-title {
  margin-bottom: 12rpx;
}

.task-swipe {
  position: relative;
  overflow: hidden;
  border-top: 1px solid #f1f2ef;
}

.task-swipe:first-of-type {
  border-top: 0;
}

.task-row {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 132rpx;
  border-top: 0;
  background: #ffffff;
}

.task-info {
  flex: 1;
  min-width: 0;
}

.task-cover {
  flex: 0 0 112rpx;
  width: 112rpx;
  height: 112rpx;
  border-radius: 12rpx;
  background: #f2f2f0;
}

.task-name {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  line-height: 1.4;
  word-break: break-all;
}

.task-title-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14rpx;
}

.task-status {
  flex: 0 0 auto;
  max-width: 190rpx;
  padding: 5rpx 10rpx;
  border-radius: 999rpx;
  background: #eef6f3;
  color: #1f6b54;
  font-size: 21rpx;
  line-height: 1.3;
  text-align: right;
}

.task-desc {
  margin-top: 8rpx;
  color: #756b5f;
  font-size: 23rpx;
  line-height: 1.45;
  word-break: break-all;
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.task-time {
  margin-top: 6rpx;
}

.task-location {
  margin-top: 6rpx;
  line-height: 1.45;
  word-break: break-all;
}

.envelope-row {
  overflow: hidden;
  align-items: stretch;
  margin: 18rpx 0;
  padding: 22rpx;
  border: 1px solid #eadfcf;
  border-radius: 18rpx;
  background: linear-gradient(145deg, #fffdf8, #fbf3e8);
  box-shadow: 0 8rpx 20rpx rgba(74, 56, 31, 0.06);
}

.envelope-row::before,
.envelope-row::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  height: 1px;
  background: rgba(211, 191, 163, 0.62);
  transform-origin: center;
}

.envelope-row::before {
  top: 50%;
  transform: rotate(9deg);
}

.envelope-row::after {
  top: 50%;
  transform: rotate(-9deg);
}

.envelope-lines {
  position: absolute;
  left: 18rpx;
  top: 18rpx;
  width: 64rpx;
  height: 40rpx;
  border-top: 4rpx solid #d9c7aa;
  border-bottom: 4rpx solid #d9c7aa;
  opacity: 0.62;
}

.envelope-info {
  position: relative;
  z-index: 2;
  padding-right: 10rpx;
}

.envelope-stamp {
  border: 2rpx solid #9c7a42;
  background: rgba(255, 248, 237, 0.8);
  color: #8a6830;
  font-weight: 700;
  transform: rotate(4deg);
}

.postage-cover {
  position: relative;
  z-index: 2;
  border: 4rpx solid #ffffff;
  border-radius: 8rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.12);
}
