.index-page {
  min-height: 100vh;
  padding: 48rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #f9fcf8 0%, #eef6ed 42%, #dcebdd 100%);
}

.loading-card,
.load-error-card {
  min-height: 360rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.loading-spinner {
  width: 56rpx;
  height: 56rpx;
  border: 6rpx solid rgba(41, 100, 72, 0.14);
  border-top-color: #296448;
  border-radius: 999rpx;
  animation: mystwood-spin 0.9s linear infinite;
}

@keyframes mystwood-spin {
  to { transform: rotate(360deg); }
}

.empty-title,
.task-empty-title,
.pending-space-title {
  color: #203329;
  font-size: 34rpx;
  font-weight: 600;
}

.error-hint {
  margin: 14rpx 0 24rpx;
}

.retry-button {
  min-width: 240rpx;
}

.empty-space {
  min-height: calc(100vh - 96rpx);
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.empty-treehouse {
  width: 92rpx;
  height: 92rpx;
  margin-bottom: 28rpx;
}

.empty-create-button {
  width: 100%;
  margin-top: 64rpx;
}

.space-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.space-title {
  flex: 1;
  min-width: 0;
  color: #203329;
  font-size: 42rpx;
  font-weight: 600;
  line-height: 1.3;
  word-break: break-all;
}

.settings-icon {
  flex: 0 0 72rpx;
  width: 72rpx;
  height: 72rpx;
  min-height: 72rpx;
  margin: 0;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid #dce8da;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.82);
}

.settings-icon-image {
  width: 34rpx;
  height: 34rpx;
}

.daily-copy {
  margin-top: 20rpx;
}

.daily-label {
  color: #7e9a6b;
  font-size: 21rpx;
}

.happy-line {
  margin-top: 10rpx;
  color: #66766a;
  font-size: 27rpx;
  line-height: 1.55;
}

.memory-link {
  width: 100%;
  min-height: 152rpx;
  margin: 34rpx 0 0;
  padding: 24rpx 26rpx;
  display: flex;
  align-items: center;
  gap: 22rpx;
  border: 1px solid #dce8da;
  border-radius: 16rpx;
  background: rgba(243, 248, 241, 0.94);
  text-align: left;
}

.memory-icon {
  flex: 0 0 44rpx;
  width: 44rpx;
  height: 44rpx;
}

.memory-copy {
  flex: 1;
  min-width: 0;
}

.memory-title {
  color: #203329;
  font-size: 29rpx;
  font-weight: 600;
}

.memory-count {
  margin-top: 10rpx;
  color: #66766a;
  font-size: 23rpx;
}

.memory-arrow,
.task-arrow {
  flex: 0 0 32rpx;
  width: 32rpx;
  height: 32rpx;
}

.pending-space-panel {
  margin-top: 36rpx;
  padding: 30rpx;
  border: 1px solid #dce8da;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.92);
}

.pending-space-panel .hint {
  margin-top: 10rpx;
}

.pending-invite-button {
  width: 100%;
  margin-top: 26rpx;
}

.create-task-entry {
  width: 100%;
  height: 96rpx;
  margin: 28rpx 0 0;
  line-height: 96rpx;
  font-size: 30rpx;
}

.task-section {
  margin-top: 52rpx;
}

.task-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 22rpx;
}

.task-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  min-height: 188rpx;
  box-sizing: border-box;
  padding: 26rpx 28rpx;
  border: 1px solid #dce8da;
  border-radius: 16rpx;
  background: #ffffff;
}

.task-info {
  flex: 1;
  min-width: 0;
}

.task-name {
  color: #203329;
  font-size: 29rpx;
  font-weight: 600;
  line-height: 1.4;
  word-break: break-all;
}

.task-meta,
.task-location-hit {
  margin-top: 10rpx;
  color: #66766a;
  font-size: 23rpx;
  line-height: 1.4;
}

.task-location-hit {
  color: #296448;
}

.task-status {
  display: inline-flex;
  min-height: 40rpx;
  align-items: center;
  margin-top: 14rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  line-height: 40rpx;
}

.waiting-status {
  background: #faf0dd;
  color: #88672e;
}

.active-status {
  background: #e4eedf;
  color: #296448;
}

.task-avatar {
  flex: 0 0 108rpx;
  width: 108rpx;
  height: 108rpx;
  border-radius: 999rpx;
}

.task-empty {
  margin-top: 52rpx;
  padding: 40rpx 0;
  text-align: center;
}

.task-empty .hint {
  margin-top: 12rpx;
}
