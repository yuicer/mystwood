<view class="page-wrap">
  <view wx:if="{{isLoadingMemories}}" class="card loading-card">
    <view class="loading-spinner"></view>
  </view>

  <view wx:elif="{{loadError}}" class="card load-error-card">
    <view class="empty-title">暂时没有同步成功</view>
    <view class="hint error-hint">{{loadError}}</view>
    <button class="btn-primary retry-button" bindtap="retryLoadMemories">重新加载</button>
  </view>

  <view wx:else class="card memory-card">
    <view class="section-title memory-section-title">回忆时间线</view>
    <view wx:if="{{memories.length === 0}}" class="hint memory-empty">还没有回忆。</view>
    <view wx:for="{{memories}}" wx:key="_id" class="list-item memory-row" data-id="{{item._id}}" bindtap="openMemoryDetail">
      <view class="memory-title-row">
        <view class="memory-title">{{item.title}}</view>
        <view class="memory-status memory-stamp">{{item.statusText}}</view>
      </view>
      <view wx:if="{{item.desc}}" class="memory-desc">{{item.desc}}</view>
      <view wx:if="{{item.timeText}}" class="hint memory-time">{{item.timeText}}</view>
      <view wx:if="{{item.locationTitle}}" class="hint location-link memory-location" data-index="{{index}}" catchtap="openMemoryLocation">{{item.locationTitle}}</view>
    </view>
  </view>
</view>
