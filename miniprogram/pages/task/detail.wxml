<view class="page-wrap">
  <view wx:if="{{isLoading}}" class="card loading-card">
    <view class="loading-spinner"></view>
  </view>

  <view wx:elif="{{task}}" class="card detail-card">
    <view class="detail-header">
      <view>
        <view class="detail-title">{{task.title}}</view>
        <view class="detail-badges">
          <view class="detail-kind">{{kindText}}</view>
          <view class="detail-status">{{statusText}}</view>
        </view>
      </view>
    </view>

    <view wx:if="{{responseText}}" class="response-card">
      <view class="detail-label">TA 的回应</view>
      <view class="detail-value">{{responseText}}</view>
    </view>

    <view class="detail-section">
      <view class="detail-label">详细描述</view>
      <view class="detail-value">{{task.desc || "未填写"}}</view>
    </view>

    <view class="detail-section">
      <view class="detail-label">目标时间</view>
      <view class="detail-value">{{appointmentText || "未约定"}}</view>
    </view>

    <view class="detail-section">
      <view class="detail-label">地点</view>
      <view wx:if="{{locationTitle}}" class="detail-link" bindtap="openLocation">{{locationTitle}}</view>
      <view wx:else class="detail-value">未选择</view>
    </view>

    <view class="detail-section">
      <view class="detail-label">图片</view>
      <view wx:if="{{taskImages.length}}" class="detail-image-grid">
        <image
          wx:for="{{taskImages}}"
          wx:key="url"
          class="detail-image"
          src="{{item.url}}"
          mode="aspectFill"
          data-index="{{index}}"
          bindtap="previewImage"
        ></image>
      </view>
      <view wx:else class="detail-empty-image">还没有图片</view>
    </view>

    <view wx:if="{{completionText}}" class="detail-section compact">
      <view class="detail-label">完成进度</view>
      <view class="detail-value">{{completionText}}</view>
    </view>

    <view class="detail-grid">
      <view class="detail-section compact">
        <view class="detail-label">创建时间</view>
        <view class="detail-value">{{createdText || "未知"}}</view>
      </view>
      <view wx:if="{{completedText}}" class="detail-section compact">
        <view class="detail-label">完成时间</view>
        <view class="detail-value">{{completedText}}</view>
      </view>
    </view>

    <view wx:if="{{isResponding}}" class="response-form">
      <view class="response-title">{{responseDecision === 'accept' ? "留一句回应（选填）" : "想对 TA 说什么（选填）"}}</view>
      <textarea class="response-input" maxlength="120" placeholder="写下你的想法" value="{{responseNote}}" show-confirm-bar="{{false}}" bindinput="onResponseNoteInput"></textarea>
      <view class="action-panel">
        <button class="action-button" bindtap="cancelResponse">取消</button>
        <button class="btn-primary action-button" bindtap="submitResponse">{{isSubmittingResponse ? "提交中" : "确认"}}</button>
      </view>
    </view>

    <view wx:else class="action-stack">
      <view wx:if="{{task.permissions.canAccept}}" class="action-panel">
        <button class="action-button" bindtap="startResponse" data-decision="decline">婉拒</button>
        <button class="btn-primary action-button" bindtap="startResponse" data-decision="accept">同意并开始</button>
      </view>
      <button wx:if="{{task.permissions.canComplete}}" class="btn-primary action-button full-action" bindtap="completeTask">{{completeActionText}}</button>
      <button wx:if="{{task.permissions.canShare}}" class="action-button full-action" open-type="share">微信分享给 TA</button>
      <button wx:if="{{task.permissions.canDelete}}" class="danger-button action-button full-action" bindtap="deleteTask">删除约定</button>
    </view>
  </view>
</view>
