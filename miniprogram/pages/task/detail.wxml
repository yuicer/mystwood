<view class="page-wrap">
  <view wx:if="{{isLoading}}" class="card loading-card">
    <view class="loading-spinner"></view>
  </view>

  <view wx:elif="{{task}}" class="card detail-card">
    <view class="detail-header">
      <view>
        <view class="detail-title">{{task.title}}</view>
        <view class="detail-status">{{statusText}}</view>
      </view>
      <button wx:if="{{!isEditing}}" class="detail-edit-button" bindtap="enterEdit">编辑</button>
    </view>

    <block wx:if="{{isEditing}}">
      <view class="edit-form">
        <input class="field title-field" placeholder="任务名称" value="{{editForm.title}}" maxlength="40" bindinput="onEditTitleInput" />
        <textarea class="field description-field" placeholder="详细描述（选填）" value="{{editForm.desc}}" maxlength="240" show-confirm-bar="{{false}}" bindinput="onEditDescInput" />

        <view class="meta-stack">
          <view class="meta-field location-picker {{editSelectedLocationName ? 'location-picked' : ''}}" bindtap="chooseEditLocation">
            <view class="location-icon"></view>
            <view class="meta-text">{{editSelectedLocationName || "选择地点"}}</view>
          </view>
          <picker class="meta-picker" mode="multiSelector" range="{{editAppointmentRange}}" value="{{editAppointmentIndex}}" bindchange="onEditAppointmentPick">
            <view class="meta-field appointment-picker {{editAppointmentText ? 'appointment-picked' : ''}}">
              <view class="clock-icon"></view>
              <view class="meta-text">{{editAppointmentText || "目标时间"}}</view>
            </view>
          </picker>
        </view>

        <view class="image-grid">
          <view
            wx:for="{{editImageItems}}"
            wx:key="fileID"
            class="image-thumb"
            data-index="{{index}}"
            bindtap="previewEditImage"
          >
            <image class="image-preview" src="{{item.previewUrl}}" mode="aspectFill"></image>
            <view class="image-remove" data-index="{{index}}" catchtap="removeEditImage"></view>
          </view>

          <view wx:if="{{editImageItems.length < maxImageCount}}" class="image-upload {{isUploadingImages ? 'image-upload-disabled' : ''}}" bindtap="chooseEditImage">
            <view class="upload-plus"></view>
            <view class="upload-text">{{isUploadingImages ? "上传中" : "上传图片"}}</view>
          </view>
        </view>
      </view>

      <view class="action-panel">
        <button class="action-button" bindtap="cancelEdit">取消</button>
        <button class="btn-primary action-button" bindtap="saveEdit">{{isSavingEdit ? "保存中" : "保存"}}</button>
      </view>
    </block>

    <block wx:else>
      <view class="detail-section">
        <view class="detail-label">详细描述</view>
        <view class="detail-value">{{task.desc || "未填写"}}</view>
      </view>

      <view class="detail-section">
        <view class="detail-label">目标时间</view>
        <view class="detail-value">{{appointmentText}}</view>
      </view>

      <view class="detail-section">
        <view class="detail-label">地点</view>
        <view wx:if="{{locationTitle}}" class="detail-link" bindtap="openLocation">{{locationTitle}}</view>
        <view wx:else class="detail-value">未选择</view>
      </view>

      <view class="detail-section">
        <view class="detail-label">图片</view>
        <view wx:if="{{taskImages.length}}" class="detail-image-grid">
          <image
            wx:for="{{taskImages}}"
            wx:key="url"
            class="detail-image"
            src="{{item.url}}"
            mode="aspectFill"
            data-index="{{index}}"
            bindtap="previewImage"
          ></image>
        </view>
        <view wx:else class="detail-empty-image">还没有图片</view>
      </view>

      <view class="detail-grid">
        <view class="detail-section compact">
          <view class="detail-label">创建时间</view>
          <view class="detail-value">{{createdText || "未知"}}</view>
        </view>
        <view wx:if="{{completedText}}" class="detail-section compact">
          <view class="detail-label">完成时间</view>
          <view class="detail-value">{{completedText}}</view>
        </view>
      </view>

      <view class="action-panel">
        <button wx:if="{{task.status === 'todo'}}" class="btn-primary action-button" bindtap="completeTask">完成任务</button>
        <button class="danger-button action-button" bindtap="deleteTask">删除任务</button>
      </view>
    </block>
  </view>
</view>
