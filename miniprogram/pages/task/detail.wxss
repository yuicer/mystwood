.letter-page {
  background: linear-gradient(180deg, rgba(250, 248, 242, 0.82), rgba(235, 241, 236, 0.72));
}

.loading-card {
  min-height: 220rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.loading-spinner {
  width: 56rpx;
  height: 56rpx;
  border: 6rpx solid rgba(47, 47, 47, 0.12);
  border-top-color: #2f2f2f;
  border-radius: 999rpx;
  animation: mystwood-spin 0.9s linear infinite;
}

@keyframes mystwood-spin {
  to { transform: rotate(360deg); }
}

.detail-shell {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.letter-card {
  position: relative;
  overflow: hidden;
  padding: 34rpx 28rpx 30rpx;
  border-color: #e5ddcf;
  background: linear-gradient(180deg, #fffdf8, #fffaf0);
  box-shadow: 0 12rpx 30rpx rgba(72, 51, 26, 0.08);
}

.letter-card::before {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 12rpx;
  background: repeating-linear-gradient(135deg, #d66f61 0 28rpx, #fff8ed 28rpx 56rpx, #6f9eb2 56rpx 84rpx, #fff8ed 84rpx 112rpx);
}

.letter-stamp {
  position: absolute;
  right: 28rpx;
  top: 34rpx;
  max-width: 190rpx;
  padding: 10rpx 16rpx;
  border: 3rpx solid #9c7a42;
  border-radius: 18rpx;
  color: #8a6830;
  font-size: 23rpx;
  font-weight: 700;
  opacity: 0.82;
  transform: rotate(8deg);
  text-align: center;
}

.letter-stamp.done {
  border-color: #28785b;
  color: #28785b;
}

.letter-stamp.declined {
  border-color: #b05b56;
  color: #b05b56;
}

.letter-header {
  padding-right: 210rpx;
}

.letter-label {
  margin-bottom: 10rpx;
  color: #9b8565;
  font-size: 22rpx;
  letter-spacing: 2rpx;
  text-transform: uppercase;
}

.detail-title {
  color: #252525;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.35;
  word-break: break-all;
}

.letter-body {
  margin-top: 34rpx;
  padding-top: 10rpx;
  border-top: 1px dashed #dccfbd;
}

.detail-section,
.response-card {
  margin-top: 28rpx;
}

.response-card {
  padding: 20rpx;
  border-radius: 16rpx;
  background: rgba(238, 247, 242, 0.86);
}

.detail-label {
  color: #85796a;
  font-size: 24rpx;
}

.detail-value,
.detail-link {
  margin-top: 8rpx;
  color: #37352f;
  font-size: 28rpx;
  line-height: 1.55;
  word-break: break-all;
}

.letter-copy {
  min-height: 96rpx;
  padding: 18rpx 0;
  color: #322f29;
}

.detail-link {
  color: #16834a;
}

.detail-image-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 14rpx;
}

.detail-image {
  width: 100%;
  height: 180rpx;
  border-radius: 14rpx;
  background: #f2f2f0;
}

.detail-empty-image {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 150rpx;
  margin-top: 12rpx;
  border: 3rpx dashed #ded2c0;
  border-radius: 16rpx;
  color: #8a8175;
  font-size: 25rpx;
  background: rgba(255, 255, 255, 0.68);
}

.meta-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.compact {
  padding-top: 0;
}

.response-form {
  margin-top: 34rpx;
  padding: 22rpx;
  border-radius: 16rpx;
  background: #f6faf9;
}

.response-title {
  color: #37352f;
  font-size: 27rpx;
  font-weight: 600;
}

.response-input,
.reply-input {
  box-sizing: border-box;
  width: 100%;
  padding: 16rpx;
  border: 1px solid #e5e7eb;
  border-radius: 14rpx;
  background: #ffffff;
  color: #37352f;
  font-size: 27rpx;
  line-height: 1.5;
}

.response-input {
  height: 136rpx;
  margin-top: 16rpx;
}

.action-stack {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 38rpx;
}

.action-panel {
  display: flex;
  gap: 10rpx;
  margin-top: 38rpx;
}

.action-stack .action-panel {
  margin-top: 0;
}

.action-button {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  margin: 0;
  border-radius: 12rpx;
  font-size: 30rpx;
}

.full-action {
  width: 100%;
}

.danger-button {
  background: #e03e3e;
  color: #ffffff;
  border-color: #e03e3e;
}

.chat-card {
  background: #ededed;
  border-color: rgba(0, 0, 0, 0.04);
}

.chat-title-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.chat-empty {
  padding: 32rpx 0;
  color: #8a8a8a;
  font-size: 25rpx;
  text-align: center;
}

.chat-list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.reply-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
}

.reply-row.mine {
  flex-direction: row-reverse;
}

.reply-avatar {
  flex: 0 0 68rpx;
  width: 68rpx;
  height: 68rpx;
  border-radius: 12rpx;
  background: #d8ded8;
  color: #466052;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 68rpx;
  text-align: center;
}

.reply-row.mine .reply-avatar {
  background: #b8ddb7;
  color: #1f5c2d;
}

.reply-content {
  max-width: 520rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.reply-row.mine .reply-content {
  align-items: flex-end;
}

.reply-meta {
  margin-bottom: 6rpx;
  color: #8a8a8a;
  font-size: 21rpx;
}

.reply-bubble {
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: #ffffff;
  color: #262626;
  font-size: 28rpx;
  line-height: 1.5;
  word-break: break-all;
}

.reply-row.mine .reply-bubble {
  background: #95ec69;
}

.reply-image-grid,
.reply-draft-grid {
  display: grid;
  grid-template-columns: repeat(3, 144rpx);
  gap: 10rpx;
  margin-top: 10rpx;
}

.reply-image,
.reply-draft-image {
  width: 144rpx;
  height: 144rpx;
  border-radius: 12rpx;
  background: #d8d8d8;
}

.reply-composer {
  margin-top: 28rpx;
  padding-top: 22rpx;
  border-top: 1px solid rgba(0, 0, 0, 0.08);
}

.reply-input {
  height: 132rpx;
}

.reply-draft-item {
  position: relative;
}

.reply-draft-remove {
  position: absolute;
  right: -8rpx;
  top: -8rpx;
  width: 34rpx;
  height: 34rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.66);
  color: #ffffff;
  font-size: 28rpx;
  line-height: 31rpx;
  text-align: center;
}

.reply-toolbar {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
}

.reply-tool-button,
.reply-send-button {
  height: 72rpx;
  line-height: 72rpx;
  margin: 0;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.reply-tool-button {
  flex: 1;
  background: #ffffff;
}

.reply-send-button {
  flex: 0 0 180rpx;
}
