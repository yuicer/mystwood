.loading-card {
  min-height: 220rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.loading-spinner {
  width: 56rpx;
  height: 56rpx;
  border: 6rpx solid rgba(47, 47, 47, 0.12);
  border-top-color: #2f2f2f;
  border-radius: 999rpx;
  animation: mystwood-spin 0.9s linear infinite;
}

@keyframes mystwood-spin {
  to {
    transform: rotate(360deg);
  }
}

.detail-card {
  padding-bottom: 30rpx;
}

.detail-title {
  color: #252525;
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1.35;
  word-break: break-all;
}

.detail-badges {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.detail-kind,
.detail-status {
  display: inline-flex;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
}

.detail-kind {
  background: #f3f0ea;
  color: #756b5f;
}

.detail-status {
  background: #eef6f3;
  color: #1f6b54;
}

.detail-section,
.response-card {
  margin-top: 28rpx;
}

.response-card {
  padding: 20rpx;
  border-radius: 14rpx;
  background: #f6faf9;
}

.detail-label {
  color: #787774;
  font-size: 24rpx;
}

.detail-value,
.detail-link {
  margin-top: 8rpx;
  color: #37352f;
  font-size: 28rpx;
  line-height: 1.5;
  word-break: break-all;
}

.detail-link {
  color: #16834a;
}

.detail-image-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
  margin-top: 12rpx;
}

.detail-image {
  width: 100%;
  height: 220rpx;
  border-radius: 12rpx;
  background: #f2f2f0;
}

.detail-empty-image {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 160rpx;
  margin-top: 12rpx;
  border: 3rpx dashed #dedede;
  border-radius: 12rpx;
  color: #787774;
  font-size: 25rpx;
  background: #ffffff;
}

.detail-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 0;
}

.compact {
  padding-top: 0;
}

.response-form {
  margin-top: 34rpx;
  padding: 22rpx;
  border-radius: 14rpx;
  background: #f6faf9;
}

.response-title {
  color: #37352f;
  font-size: 27rpx;
  font-weight: 600;
}

.response-input {
  box-sizing: border-box;
  width: 100%;
  height: 136rpx;
  margin-top: 16rpx;
  padding: 14rpx;
  border: 1px solid #e5e7eb;
  border-radius: 10rpx;
  background: #ffffff;
  color: #37352f;
  font-size: 27rpx;
  line-height: 1.5;
}

.action-stack {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 38rpx;
}

.action-panel {
  display: flex;
  gap: 10rpx;
  margin-top: 38rpx;
}

.action-stack .action-panel {
  margin-top: 0;
}

.action-button {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  margin: 0;
  border-radius: 10rpx;
  font-size: 30rpx;
}

.full-action {
  width: 100%;
}

.danger-button {
  background: #e03e3e;
  color: #ffffff;
  border-color: #e03e3e;
}
