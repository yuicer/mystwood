.task-create-page {
  padding-bottom: 64rpx;
}

.kind-options {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 34rpx;
}

.kind-option {
  min-height: 64rpx;
  margin: 0;
  padding: 0 26rpx;
  border: 1px solid #dce8da;
  border-radius: 999rpx;
  background: #ffffff;
  color: #66766a;
  font-size: 24rpx;
  line-height: 64rpx;
}

.kind-option-selected {
  border-color: #296448;
  background: #296448;
  color: #ffffff;
}

.form-group {
  margin-top: 44rpx;
}

.title-field {
  width: 100%;
  height: 104rpx;
  font-size: 29rpx;
}

.description-field {
  width: 100%;
  height: 176rpx;
  min-height: 176rpx;
  font-size: 27rpx;
  line-height: 1.55;
}

.meta-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 18rpx;
  margin-top: 44rpx;
}

.meta-picker {
  display: block;
  min-width: 0;
}

.meta-field {
  display: flex;
  align-items: center;
  gap: 14rpx;
  box-sizing: border-box;
  min-width: 0;
  min-height: 128rpx;
  padding: 18rpx;
  border: 1px solid #dce8da;
  border-radius: 16rpx;
  background: #ffffff;
}

.meta-icon {
  flex: 0 0 36rpx;
  width: 36rpx;
  height: 36rpx;
}

.meta-copy {
  min-width: 0;
}

.meta-label {
  color: #66766a;
  font-size: 20rpx;
}

.meta-text {
  margin-top: 7rpx;
  overflow: hidden;
  color: #66766a;
  font-size: 23rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.meta-picked .meta-text {
  color: #203329;
}

.image-section {
  margin-top: 48rpx;
}

.image-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.image-limit {
  color: #66766a;
  font-size: 21rpx;
}

.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  margin-top: 20rpx;
}

.image-thumb,
.image-upload {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 180rpx;
  height: 180rpx;
  overflow: hidden;
  border-radius: 16rpx;
}

.image-upload {
  border: 1px solid #dce8da;
  background: #ffffff;
}

.image-upload-disabled {
  opacity: 0.6;
}

.upload-text {
  color: #296448;
  font-size: 25rpx;
}

.image-preview {
  width: 100%;
  height: 100%;
}

.image-remove {
  position: absolute;
  right: 8rpx;
  top: 8rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 999rpx;
  background: rgba(32, 51, 41, 0.72);
}

.image-remove::before,
.image-remove::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 18rpx;
  height: 3rpx;
  background: #ffffff;
  transform-origin: center;
}

.image-remove::before {
  transform: translate(-50%, -50%) rotate(45deg);
}

.image-remove::after {
  transform: translate(-50%, -50%) rotate(-45deg);
}

.create-button {
  width: 100%;
  height: 96rpx;
  margin-top: 52rpx;
  line-height: 96rpx;
  font-size: 30rpx;
}
