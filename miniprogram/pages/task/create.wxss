.kind-heading {
  margin-bottom: 18rpx;
  color: #37352f;
  font-size: 28rpx;
  font-weight: 600;
}

.kind-options {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 26rpx;
}

.kind-option {
  width: 100%;
  margin: 0;
  padding: 18rpx 20rpx;
  border: 2rpx solid #e5e7eb;
  border-radius: 14rpx;
  background: #ffffff;
  color: #37352f;
  line-height: 1.35;
  text-align: left;
}

.kind-option::after {
  border: 0;
}

.kind-option-selected {
  border-color: #5a9b84;
  background: #f2faf6;
}

.kind-title {
  font-size: 28rpx;
  font-weight: 600;
}

.kind-desc {
  margin-top: 6rpx;
  color: #787774;
  font-size: 23rpx;
}

.title-field {
  box-sizing: border-box;
  width: 100%;
  height: 80rpx;
  min-height: 80rpx;
  padding: 0 18rpx;
  font-size: 30rpx;
}

.description-field {
  box-sizing: border-box;
  width: 100%;
  height: 132rpx;
  min-height: 132rpx;
  line-height: 1.55;
}

.meta-stack {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 10rpx;
}

.meta-picker {
  display: block;
  width: 100%;
  height: 80rpx;
  min-width: 0;
}

.meta-field {
  display: flex;
  align-items: center;
  gap: 10rpx;
  box-sizing: border-box;
  width: 100%;
  min-height: 80rpx;
  border: 1px solid #e5e7eb;
  border-radius: 12rpx;
  padding: 0 14rpx;
  background: #ffffff;
  color: #787774;
}

.appointment-picker {
  height: 80rpx;
}

.location-picked {
  color: #16834a;
  font-weight: 600;
}

.appointment-picked {
  color: #37352f;
}

.meta-text {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.location-icon,
.clock-icon {
  position: relative;
  flex: 0 0 30rpx;
  width: 30rpx;
  height: 30rpx;
  box-sizing: border-box;
  color: inherit;
}

.location-icon {
  width: 28rpx;
  height: 28rpx;
  margin-top: -6rpx;
  border: 3rpx solid currentColor;
  border-radius: 50% 50% 50% 0;
  transform: rotate(-45deg);
}

.location-icon::before,
.clock-icon::before,
.clock-icon::after {
  content: '';
  position: absolute;
  background: currentColor;
}

.location-icon::before {
  left: 50%;
  top: 50%;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  transform: translate(-50%, -50%);
}

.clock-icon {
  border: 3rpx solid currentColor;
  border-radius: 50%;
}

.clock-icon::before {
  left: 50%;
  top: 7rpx;
  width: 3rpx;
  height: 9rpx;
  transform: translateX(-50%);
}

.clock-icon::after {
  left: 50%;
  top: 50%;
  width: 9rpx;
  height: 3rpx;
  transform: translateY(-50%);
}

.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 24rpx;
}

.image-thumb,
.image-upload {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 156rpx;
  height: 156rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.image-upload {
  flex-direction: column;
  gap: 12rpx;
  border: 3rpx dashed #dedede;
  background: #ffffff;
  color: #777777;
}

.image-upload-disabled {
  opacity: 0.72;
}

.upload-plus {
  position: relative;
  flex: 0 0 34rpx;
  width: 34rpx;
  height: 34rpx;
}

.upload-plus::before,
.upload-plus::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  background: #a8a8a8;
  transform: translate(-50%, -50%);
}

.upload-plus::before {
  width: 34rpx;
  height: 4rpx;
}

.upload-plus::after {
  width: 4rpx;
  height: 34rpx;
}

.upload-text {
  font-size: 24rpx;
  color: #777777;
}

.image-preview {
  width: 100%;
  height: 100%;
}

.image-remove {
  position: absolute;
  right: 8rpx;
  top: 8rpx;
  width: 34rpx;
  height: 34rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.48);
}

.image-remove::before,
.image-remove::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 18rpx;
  height: 3rpx;
  background: #ffffff;
  transform-origin: center;
}

.image-remove::before {
  transform: translate(-50%, -50%) rotate(45deg);
}

.image-remove::after {
  transform: translate(-50%, -50%) rotate(-45deg);
}

.create-button {
  margin-top: 56rpx;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 32rpx;
  border-radius: 10rpx;
}
