<view class="page-wrap">
  <view class="card">
    <view class="kind-heading">这次想做一个怎样的约定？</view>
    <view class="kind-options">
      <button
        wx:for="{{kindOptions}}"
        wx:key="value"
        class="kind-option {{selectedKind === item.value ? 'kind-option-selected' : ''}}"
        data-kind="{{item.value}}"
        bindtap="selectKind"
      >
        <view class="kind-title">{{item.title}}</view>
        <view class="kind-desc">{{item.desc}}</view>
      </button>
    </view>

    <input class="field title-field" placeholder="约定名称" value="{{form.title}}" maxlength="40" bindinput="onTitleInput" />
    <textarea class="field description-field" placeholder="详细描述（选填）" value="{{form.desc}}" maxlength="240" show-confirm-bar="{{false}}" bindinput="onDescInput" />

    <view class="meta-stack">
      <view class="meta-field location-picker {{selectedLocationName ? 'location-picked' : ''}}" bindtap="chooseLocation">
        <view class="location-icon"></view>
        <view class="meta-text">{{selectedLocationName || "选择地点"}}</view>
      </view>
      <picker class="meta-picker" mode="multiSelector" range="{{appointmentRange}}" value="{{appointmentIndex}}" bindchange="onAppointmentPick">
        <view class="meta-field appointment-picker {{appointmentText ? 'appointment-picked' : ''}}">
          <view class="clock-icon"></view>
          <view class="meta-text">{{appointmentText || "目标时间"}}</view>
        </view>
      </picker>
    </view>

    <view class="image-grid">
      <view
        wx:for="{{imageItems}}"
        wx:key="fileID"
        class="image-thumb"
        data-index="{{index}}"
        bindtap="previewImage"
      >
        <image class="image-preview" src="{{item.previewUrl}}" mode="aspectFill"></image>
        <view class="image-remove" data-index="{{index}}" catchtap="removeImage"></view>
      </view>

      <view wx:if="{{imageItems.length < maxImageCount}}" class="image-upload {{isUploadingImage ? 'image-upload-disabled' : ''}}" bindtap="chooseImage">
        <view class="upload-plus"></view>
        <view class="upload-text">{{isUploadingImage ? "上传中" : "上传图片"}}</view>
      </view>
    </view>

    <button class="btn-primary create-button" bindtap="create">发出约定</button>
  </view>
</view>
